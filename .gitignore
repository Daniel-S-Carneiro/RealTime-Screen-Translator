# ==========================================
# Ambientes Virtuais e Cache Python
# ==========================================
env/
env_build/
venv/
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Pastas de Build e Distribuição (PyInstaller)
# ==========================================
build/
dist/
*.spec

# ==========================================
# Arquivos de IDE
# ==========================================
.vscode/

# ==========================================
# Arquivos Temporários de Imagem do App
# ==========================================
captura.png
processada.png

# ==========================================
# Executáveis / Instaladores
# ==========================================
*.exe

# ==========================================
# Modelos baixados e prints do benchmark
# ==========================================
modelos/
# Os prints coletados (e os rascunhos do OCR) ficam só na máquina local: são telas
# de jogos de terceiros e mudam a cada coleta. Só a pasta base/, com os 3 exemplos,
# vai para o git.
benchmark/dataset/*
!benchmark/dataset/base/

# ==========================================
# Laboratórios antigos e relatórios (ficam só na máquina local)
# ==========================================
laboratorios/
relatorios/

# Rascunho do post do LinkedIn (só vai a público quando for publicado)
docs/post-linkedin.md

# Pyright instalado localmente (a versão fica em ferramentas/package.json)
ferramentas/node_modules/

# Preferências pessoais do Claude Code
.claude/settings.local.json
